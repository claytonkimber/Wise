# Directories
.tmp.driveupload/
.tmp.drivedownload/
.agent/
# Ignore all of .claude EXCEPT the shared, path-agnostic settings.json.
# settings.local.json (personal paths/permissions) stays ignored.
.claude/*
!.claude/settings.json
.codesight/
node_modules/

# Configuration and Rule Files
.antigravityrules
CLAUDE.md
JULES.md
GEMINI.md

# Testing scripts
*.py
.mcp.json

# Runtime state written by tools/perfy-profile.ps1 while an in-place
# instrumentation run is active. Never belongs in a commit.
.perfy-instrumented

# Scratch produced while debugging: command output dumps, SavedVariables
# extracts, loose patch files and AI/working notes. Useful locally, noise in
# the repo. Docs belong in docs/ or wiki/, not a stray plan.md at the root.
log*.txt
out.txt
grep*.txt
diff*.txt
branch.txt
dump_sv.txt
*.diff
/plan.md