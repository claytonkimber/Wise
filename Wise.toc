# Libraries
Libs\LibDBIcon\embeds.xml
Libs\LibDBIcon\LibDBIcon-1.0\lib.xml
Libs\LibSharedMedia-3.0\lib.xml
Libs\LibSharedMedia-3.0\WiseMedia.lua
Libs\exui\exui.xml

# Bindings.xml is deliberately absent from this list: the client auto-loads
# any root-level file named exactly "Bindings.xml" for every enabled addon,
# independent of the .toc — listing it here would load it (and register its
# bindings) twice. It declares WISE_OPEN_OPTIONS for Blizzard's Key Bindings
# UI (including its Gamepad tab) and ConsolePort_Config, which reads the same
# BINDING_HEADER_*/BINDING_NAME_* globals (see core/Bindings.lua).

# Debug (tests.xml only exists in dev — stripped by packager)
#@debug@
tests.xml
#@end-debug@
modules\Debug.lua

# Core
Wise.lua

# Blizzard-UI suppression (extracted from Wise.lua). These install hooks and
# register events at load time, so they must follow Wise.lua; Registry defines
# the frame catalogue the other two read.
core\blizzui\Registry.lua
core\blizzui\Hiding.lua
core\blizzui\Apply.lua

core\Filters.lua
core\Polyfill.lua
core\Compat121.lua
core\Text.lua
core\Bindings.lua
core\Dispatcher.lua

# Cooldown primitives (extracted from GUI.lua). SecretValues probes client
# capabilities, so it must load before anything that reads Wise.HAS_*.
core\cooldown\SecretValues.lua
core\cooldown\SwipeCache.lua

# Custom-conditional engine (extracted from GUI.lua). Order matters: each file
# takes the previous ones' internals as upvalues off Wise.CondEngine at load
# time. All must load before GUI.lua, which does the same.
core\conditionals\ZoneAbility.lua
core\conditionals\Vocabulary.lua
core\conditionals\ArgMatch.lua
core\conditionals\Predicates.lua
core\conditionals\Environment.lua
core\conditionals\EvalToken.lua
core\conditionals\ConditionString.lua

# Visual effects (extracted from GUI.lua). Both must load before GUI.lua, which
# binds the hover helpers as upvalues off Wise.Effects.
core\effects\OverlayGlow.lua
core\effects\HoverIndication.lua

# Layout helpers (extracted from GUI.lua). Must load before GUI.lua, which
# binds them as upvalues off Wise.Layout.
core\layout\ListLayout.lua

core\GUI.lua
core\Conditionals.lua

# Modules
modules\DragAndDrop.lua
modules\Tooltips.lua
modules\editmode.lua
modules\Actions.lua
modules\Settings.lua
modules\Macro.lua
modules\Options.lua
modules\Properties.lua
