# only attach methods to Wise, so the remaining order is presentational.
modules\nesting\Rules.lua
modules\nesting\Options.lua
modules\nesting\Conditionals.lua
modules\nesting\Layout.lua
modules\nesting\Position.lua
modules\nesting\CloseMonitor.lua
modules\States.lua
modules\SlotConfigurator.lua
modules\Info.lua
modules\Minimap.lua
modules\Demo.lua
modules\BugReport.lua
modules\Audio.lua
modules\AbundanceTest.lua
modules\AudioCues.lua
# Indicator rules. Metrics first (everything reads METRICS); Paint last, as it
# consumes the indexes Index.lua builds.
modules\indicators\Metrics.lua
modules\indicators\State.lua
modules\indicators\Render.lua
modules\indicators\Index.lua
modules\indicators\Paint.lua

# Wiser
wiser\Cooldowns.lua
wiser\SmartItem.lua
wiser\BarCopy.lua
wiser\AddonMagic.lua
wiser\SpecAndEquip.lua
# Disenchant/Convert wiser. Core first (everything reads its constants), Events
# last (load-time side effects; wires up functions the others define).
wiser\vdc\Core.lua
wiser\vdc\Pricing.lua
wiser\vdc\Scan.lua
wiser\vdc\Actions.lua
wiser\vdc\Slots.lua
